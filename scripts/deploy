#!/usr/bin/env bash

cd "$(dirname ${BASH_SOURCE[0]})"
basedir="$(pwd)"

cp -r ${basedir}/../home/.config/* ${HOME}/.config/

xdg-mime default org.gnome.Nautilus.desktop inode/directory
xdg-mime default org.gnome.Nautilus.desktop x-directory/normal
xdg-mime default org.gnome.Nautilus.desktop x-directory/gnome-default-handler

sudo cp -r ${basedir}/../etc/* /etc/

sudo systemctl enable dbus-broker.service
sudo systemctl enable bluetooth.service
sudo systemctl enable --now logid.service
sudo systemctl disable gdm.service

# Ensure the greetd greeter account exists and can access /dev/dri.
if ! id greeter >/dev/null 2>&1; then
    sudo useradd --system --no-create-home --shell /usr/sbin/nologin greeter
fi
sudo usermod -a -G video greeter

sudo systemctl enable greetd.service

sudo systemctl unmask firewalld
sudo systemctl enable firewalld

sudo setsebool -P antivirus_can_scan_system 1
sudo setsebool -P antivirus_use_jit 1
sudo systemctl daemon-reload
sudo freshclam
sudo systemctl enable --now clamav-freshclam
sudo systemctl enable --now clamd@scan


# Find and disable your current manager (e.g., gdm.service or sddm.service)
sudo systemctl disable --now gdm.service
# Enable greetd
sudo systemctl enable  --now greetd.service

sudo mkdir -p /var/lib/noctalia-greeter
sudo chown -R greeter:greeter /var/lib/noctalia-greeter
sudo noctalia-greeter passwordless-sync enable ${USER}
pkexec noctalia-greeter-apply-appearance --sync "/run/user/$(id -u)/noctalia-greeter-sync"
