#!/usr/bin/env bash

cd "$(dirname ${BASH_SOURCE[0]})"
basedir="$(pwd)"

cp -r ${basedir}/../home/.config/* ${HOME}/.config/

xdg-mime default org.gnome.Nautilus.desktop inode/directory
xdg-mime default org.gnome.Nautilus.desktop x-directory/normal
xdg-mime default org.gnome.Nautilus.desktop x-directory/gnome-default-handler

sudo cp -r ${basedir}/../etc/* /etc/

sudo systemctl enable dbus-broker.service
sudo systemctl enable bluetooth.service
sudo systemctl enable --now logid.service
sudo systemctl disable gdm.service

# Ensure the greetd greeter account exists and can access /dev/dri.
if ! id greeter >/dev/null 2>&1; then
    sudo useradd --system --no-create-home --shell /usr/sbin/nologin greeter
fi
sudo usermod -a -G video greeter

sudo systemctl enable greetd.service

sudo systemctl unmask firewalld
sudo systemctl enable firewalld
sudo systemctl restart systemd-resolved

sudo setsebool -P antivirus_can_scan_system 1
sudo setsebool -P antivirus_use_jit 1
sudo systemctl daemon-reload
sudo freshclam
sudo systemctl enable --now clamav-freshclam
sudo systemctl enable --now clamd@scan


# Find and disable your current manager (e.g., gdm.service or sddm.service)
sudo systemctl disable --now gdm.service
# Enable greetd
sudo systemctl enable  --now greetd.service

# Greeter state dir: owned by the greetd session user, mode 0750.
sudo install -d -o greeter -g greeter -m 0750 /var/lib/noctalia-greeter
# Creates greeter.toml + sync.toml and hands them to the greetd session user.
sudo noctalia-greeter-apply-appearance --setup-system

# Let this desktop account sync to the greeter without a prompt.
sudo noctalia-greeter passwordless-sync enable "${SUDO_USER:-$USER}"

# Push the shell appearance to the greeter. Noctalia Shell owns the staging
# directory (/run/user/<uid>/noctalia-greeter-sync); the helper only consumes
# it, so the sync has to be triggered through the shell.
if noctalia msg color-scheme-get >/dev/null 2>&1; then
    noctalia msg config-reload
    sleep 2
    out="$(noctalia msg greeter-sync 2>&1)" || true
    case "$out" in
        ok*) : ;;
        *"already in progress"*) echo "info: greeter sync already running" ;;
        *) echo "warn: greeter sync not started: $out" >&2 ;;
    esac
else
    echo "warn: Noctalia Shell is not running; log in and use Settings -> Security -> Noctalia Greeter -> Sync Now" >&2
fi
