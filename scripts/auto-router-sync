#!/usr/bin/env bash
set -e

# Ensure running as root
if [ "$EUID" -ne 0 ]; then
  echo "Error: Please run as root (sudo)."
  exit 1
fi

echo "1. Auto-detecting active primary network interface..."
# Finds the active interface routing internet traffic
INTERFACE=$(ip route show default | awk '/default/ {print $5; exit}')

if [ -z "$INTERFACE" ]; then
  echo "Error: Could not automatically detect an active network interface with a default route."
  exit 1
fi

echo "   -> Active Interface: $INTERFACE"

echo "2. Auto-detecting connection profile for $INTERFACE..."
CONNECTION_NAME=$(nmcli -g GENERAL.CONNECTION device show "$INTERFACE" 2>/dev/null || true)

if [ -z "$CONNECTION_NAME" ]; then
  echo "Error: Could not map interface $INTERFACE to an active NetworkManager profile."
  exit 1
fi

echo "   -> Connection Profile: '$CONNECTION_NAME'"

echo "3. Resetting profile to automatically accept router settings..."
# Re-enable auto-DNS to accept what your router broadcasts
nmcli connection modify "$CONNECTION_NAME" ipv4.ignore-auto-dns no
nmcli connection modify "$CONNECTION_NAME" ipv6.ignore-auto-dns no

# Strip out any previously hardcoded manual overrides
nmcli connection modify "$CONNECTION_NAME" ipv4.dns ""
nmcli connection modify "$CONNECTION_NAME" ipv4.dns-search ""

echo "4. Restoring native systemd-resolved link for /etc/resolv.conf..."
ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

echo "5. Refreshing network connection lease from the router..."
nmcli connection down "$CONNECTION_NAME"
nmcli connection up "$CONNECTION_NAME"

echo "6. Flushing local DNS caches..."
resolvectl flush-caches

echo "--------------------------------------------------------"
echo "Success! Verifying router auto-detected settings:"
echo "--------------------------------------------------------"
resolvectl status "$INTERFACE" | grep -E "(Current DNS Server|DNS Domain)" || echo "No active settings found. Ensure router DHCP options are applied."
