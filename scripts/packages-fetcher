#!/usr/bin/env bash

cd "$(dirname ${BASH_SOURCE[0]})"
basedir="$(pwd)"

sudo dnf install -y \
    git \
    @development-tools \
    dnf-plugins-core

## vscode
sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc
echo -e "[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\nautorefresh=1\ntype=rpm-md\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc" \
    | sudo tee /etc/yum.repos.d/vscode.repo \
    > /dev/null

sudo dnf copr enable -y alternateved/cliphist
sudo dnf copr enable -y scottames/ghostty

# noctalia and mission-center are shipped by Terra.
sudo dnf install -y --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release

sudo dnf check-update

. ${basedir}/packages-list

sudo dnf install -y --skip-unavailable \
    ${packages}

# Fedora 45+ uses oo7 for the Secret Service. Upgrades can leave the old
# gnome-keyring daemon installed; it keeps owning org.freedesktop.secrets, so
# the password greetd hands to pam_oo7 can never unlock the login keyring.
# Remove it once the oo7 stack is present. Keyring data is only backed up,
# never deleted; oo7 migrates it on the next login.
if rpm -q oo7-daemon pam_oo7 >/dev/null 2>&1 && rpm -q gnome-keyring >/dev/null 2>&1; then
    keyring_dir="${XDG_DATA_HOME:-${HOME}/.local/share}/keyrings"
    if [[ -d "${keyring_dir}" ]]; then
        keyring_backup="${keyring_dir}-backup-$(date +%Y%m%d-%H%M%S)"
        cp -a -- "${keyring_dir}" "${keyring_backup}"
        printf 'Backed up keyrings to %s\n' "${keyring_backup}"
    fi
    printf 'Removing stale gnome-keyring; oo7 will manage the login keyring after the next login.\n'
    printf 'If the login keyring password differs from your login password, oo7 will keep it locked.\n'
    sudo dnf remove -y --no-autoremove gnome-keyring
fi

flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

rustup-init -y
. "$HOME/.cargo/env"
sudo dnf install  -y \
    gtk4-devel \
    pipewire-devel \
    clang
cargo install wayland-pipewire-idle-inhibit

# noctalia greeter
sudo dnf install -y noctalia-greeter greetd greetd-selinux

## gtk theme
sudo dnf install -y \
    gtk-murrine-engine \
    gtk2-engines \
    sassc

theme_dir="${basedir}/../storage/Qogir-theme"
if [[ -d "${theme_dir}/.git" ]]; then
    git -C "${theme_dir}" pull --ff-only || true
else
    rm -rf -- "${theme_dir}"
    git clone https://github.com/vinceliuice/Qogir-theme.git "${theme_dir}"
fi

mkdir -p "${HOME}/.themes"
"${theme_dir}/install.sh" --tweaks round -c dark -d "${HOME}/.themes"

# Older installer runs used Qogir's `-l` option, which symlinked these paths
# into the theme and made Noctalia's GTK4 import resolve in the wrong place.
for f in gtk.css gtk-dark.css assets; do
    p="${HOME}/.config/gtk-4.0/${f}"
    target="$(readlink -- "${p}" 2>/dev/null || true)"
    if [[ -L "${p}" && "${target}" == */Qogir-Round-Dark/gtk-4.0/* ]]; then
        rm -f -- "${p}"
    fi
done

sudo rm -rf /usr/share/themes/Qogir-Round-Dark
sudo cp -r "${HOME}/.themes/Qogir-Round-Dark" /usr/share/themes/

# Flatpak apps are sandboxed and cannot read ~/.themes or /usr/share/themes,
# so expose the host theme and GTK config to them explicitly.
"${basedir}/flatpak-theme" Qogir-Round-Dark

# hardware acceleration and rpmfusion
# 1. Enable RPM Fusion Free and Nonfree repositories
echo "Enabling RPM Fusion Repositories..."
sudo dnf install -y \
  https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
  https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm

# 2. Update package metadata
echo "Refreshing DNF repositories..."
sudo dnf check-update || true

# 3. Swap open-source crippled packages for full RPM Fusion versions
echo "--> Swapping out default codecs for full FFmpeg and Freeworld Mesa..."
sudo dnf swap -y ffmpeg-free ffmpeg --allowerasing
sudo dnf install -y @multimedia --setopt="install_weak_deps=False" --exclude=PackageKit-gstreamer-plugin

# 4. Install 32-bit equivalents for Steam, Wine, and Proton compatibility
echo "Installing drivers..."
sudo dnf install mesa-va-drivers-freeworld
sudo dnf swap mesa-vulkan-drivers{,-freeworld}
sudo dnf install mesa-va-drivers-freeworld.i686
sudo dnf swap mesa-vulkan-drivers{,-freeworld}.i686